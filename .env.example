# Perfil y PostgreSQL local. Copie este archivo como .env y defina una contraseña local.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/nexastock
DB_USER=postgres
DB_PASSWORD=

# PostgreSQL Azure passwordless (perfil azure).
AZURE_POSTGRESQL_JDBC_URL=
AZURE_POSTGRESQL_USERNAME=

# URLs internas. En Container Apps use FQDN/ingress interno real.
INVENTORY_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
SUPPLIER_SERVICE_URL=http://localhost:8083
REPORTING_SERVICE_URL=http://localhost:8084
HTTP_CONNECT_TIMEOUT=3s
HTTP_READ_TIMEOUT=10s

# Autenticación servicio-a-servicio: none | propagate | managed-identity.
INTER_SERVICE_AUTH_MODE=none
AZURE_INTER_SERVICE_SCOPE=

# Reportes. Solo se usa el contenedor reports.
REPORT_STORAGE_TYPE=local
REPORT_LOCAL_DIRECTORY=./build/reports
REPORT_BLOB_ENDPOINT=
REPORT_BLOB_CONTAINER=reports

# Microsoft Foundry Responses API.
FOUNDRY_ENABLED=false
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
FOUNDRY_MAX_TOOL_ROUNDS=4
FOUNDRY_CONNECT_TIMEOUT=5s
FOUNDRY_READ_TIMEOUT=60s

# Microsoft Entra Resource Server.
APP_SECURITY_ENABLED=false
AZURE_ENTRA_ISSUER_URI=
AZURE_ENTRA_AUDIENCE=
CORS_ALLOWED_ORIGINS=http://localhost:4200
